generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  OVERDUE
  SUSPENDED
}

enum UserRole {
  SUPER_ADMIN
  SHOP_ADMIN
  CASHIER
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  REFUNDED
  VOIDED
}

enum PaymentMethod {
  CASH
  KPAY
  WAVE_PAY
  MIXED
  OTHER
}

enum SaleStatus {
  COMPLETED
  VOIDED
  RETURNED
  PARTIAL_RETURN
}

enum StockMovementType {
  STOCK_IN
  SALE
  SALE_RETURN
  DAMAGE
  ADJUSTMENT
  REPAIR_USAGE
  REVERSAL
}

enum RepairStatus {
  RECEIVED
  CHECKING
  IN_PROGRESS
  WAITING_PART
  COMPLETED
  CANNOT_REPAIR
  DELIVERED
}

enum MoneyAccountType {
  CASH
  KPAY
  WAVE_PAY
  OTHER
}

enum MoneyServiceType {
  KPAY_TRANSFER
  KPAY_CASH_OUT
  WAVE_PAY_TRANSFER
  WAVE_PAY_CASH_OUT
  ACCOUNT_ADJUSTMENT
  REVERSAL
}

enum MoneyFeeMode {
  PROPORTIONAL
  ROUND_UP_PER_100000
  MANUAL
}

enum BillerType {
  TOPUP_CARD
  ELOAD
  BILL_PAYMENT
  OTHER
}

enum BillerTransactionType {
  OPENING
  REFILL
  SOLD
  ADJUSTMENT
}

model Shop {
  id           String   @id @default(uuid()) @db.Uuid
  slug         String   @unique
  code         String?  @unique
  name         String
  phone        String?
  address      String?
  logoUrl      String?  @map("logo_url")
  businessType String   @default("PHONE_SHOP") @map("business_type")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  auditLogs                AuditLog[]
  categories               Category[]
  customers                Customer[]
  dailyClosings            DailyClosing[]
  inventoryBalances        InventoryBalance[]
  moneyAccounts            MoneyAccount[]
  moneyServiceTransactions MoneyServiceTransaction[]
  billers                  Biller[]
  billerTransactions       BillerTransaction[]
  payments                 Payment[]
  productVariants          ProductVariant[]
  products                 Product[]
  pushTokens               UserPushToken[]
  repairPayments           RepairPayment[]
  repairStatusHistory      RepairStatusHistory[]
  repairs                  Repair[]
  saleItems                SaleItem[]
  sales                    Sale[]
  settings                 ShopSettings?
  stockMovements           StockMovement[]
  subscriptions            Subscription[]
  users                    User[]
  appNotifications         AppNotification[]
  ecommerceSettings        EcommerceStoreSettings?
  ecommerceProductDetails  EcommerceProductDetail[]
  ecommerceProductImages   EcommerceProductImage[]
  ecommerceOrders          EcommerceOrder[]
  ecommerceCustomers       EcommerceCustomer[]
  ecommerceCarts           EcommerceCart[]

  @@map("shops")
}

model Subscription {
  id         String             @id @default(uuid()) @db.Uuid
  shopId     String             @map("shop_id") @db.Uuid
  status     SubscriptionStatus @default(TRIAL)
  setupFee   Decimal            @default(0) @map("setup_fee") @db.Decimal(14, 2)
  monthlyFee Decimal            @default(50000) @map("monthly_fee") @db.Decimal(14, 2)
  startsAt   DateTime           @map("starts_at") @db.Timestamptz(6)
  endsAt     DateTime           @map("ends_at") @db.Timestamptz(6)
  renewedAt  DateTime?          @map("renewed_at") @db.Timestamptz(6)
  notes      String?
  createdAt  DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, status, endsAt])
  @@map("subscriptions")
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  shopId             String?   @map("shop_id") @db.Uuid
  email              String?   @unique
  username           String
  normalizedUsername String    @map("normalized_username")
  passwordHash       String    @map("password_hash")
  passwordMustChange Boolean   @default(false) @map("password_must_change")
  name               String
  avatarUrl          String?   @map("avatar_url")
  authProvider       String?   @map("auth_provider")
  providerId         String?   @map("provider_id")
  role               UserRole
  permissions        Json      @default("{}")
  active             Boolean   @default(true)
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  approvedSaleItems        SaleItem[]                @relation("SaleItemApprover")
  appNotifications         AppNotification[]         @relation("AppNotificationUser")
  auditLogs                AuditLog[]                @relation("AuditLogUser")
  moneyServiceTransactions MoneyServiceTransaction[] @relation("MoneyServiceUser")
  billerTransactions       BillerTransaction[]       @relation("BillerTransactionStaff")
  pushTokens               UserPushToken[]           @relation("UserPushTokens")
  repairPayments           RepairPayment[]           @relation("RepairPaymentReceiver")
  repairStatusChanges      RepairStatusHistory[]     @relation("RepairStatusChanger")
  repairs                  Repair[]                  @relation("RepairTechnician")
  sales                    Sale[]                    @relation("SaleStaff")
  shop                     Shop?                     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  stockMovements           StockMovement[]           @relation("StockMovementUser")

  @@unique([shopId, normalizedUsername])
  @@unique([authProvider, providerId])
  @@index([role])
  @@index([shopId, active])
  @@map("users")
}

model ShopSettings {
  id                           String   @id @default(uuid()) @db.Uuid
  shopId                       String   @unique @map("shop_id") @db.Uuid
  receiptHeader                String?  @map("receipt_header")
  receiptFooter                String?  @map("receipt_footer")
  invoicePrefix                String   @default("MS") @map("invoice_prefix")
  repairPrefix                 String   @default("RP") @map("repair_prefix")
  currency                     String   @default("MMK")
  language                     String   @default("my")
  theme                        String   @default("light")
  allowNegativeStock           Boolean  @default(false) @map("allow_negative_stock")
  minimumPriceApprovalRequired Boolean  @default(true) @map("minimum_price_approval_required")
  moneyServiceRates            Json     @default("{}") @map("money_service_rates")
  repairStatuses               Json     @default("[]") @map("repair_statuses")
  warrantyText                 String?  @map("warranty_text")
  settings                     Json     @default("{}")
  createdAt                    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@map("shop_settings")
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  shopId    String   @map("shop_id") @db.Uuid
  name      String
  kind      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  productVariants ProductVariant[]
  products        Product[]
  shop            Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, name])
  @@index([shopId, active])
  @@map("categories")
}

model Product {
  id             String   @id @default(uuid()) @db.Uuid
  shopId         String   @map("shop_id") @db.Uuid
  categoryId     String?  @map("category_id") @db.Uuid
  groupName      String?  @map("group_name")
  name           String
  brand          String?
  model          String?
  productType    String?  @map("product_type")
  requiresSerial Boolean  @default(false) @map("requires_serial")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  category        Category?               @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  shop            Shop                    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  variants        ProductVariant[]
  ecommerceDetail EcommerceProductDetail?
  ecommerceImages EcommerceProductImage[]

  @@index([shopId, name])
  @@index([shopId, active])
  @@map("products")
}

model EcommerceStoreSettings {
  id              String   @id @default(uuid()) @db.Uuid
  shopId          String   @unique @map("shop_id") @db.Uuid
  enabled         Boolean  @default(false)
  storeName       String?  @map("store_name")
  description     String?
  contactPhone    String?  @map("contact_phone")
  telegramUrl     String?  @map("telegram_url")
  mapUrl          String?  @map("map_url")
  bannerUrl       String?  @map("banner_url")
  deliveryEnabled Boolean  @default(true) @map("delivery_enabled")
  pickupEnabled   Boolean  @default(true) @map("pickup_enabled")
  deliveryFee     Decimal  @default(0) @map("delivery_fee") @db.Decimal(14, 2)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  shop            Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@map("ecommerce_store_settings")
}

model EcommerceProductDetail {
  id          String   @id @default(uuid()) @db.Uuid
  shopId      String   @map("shop_id") @db.Uuid
  productId   String   @unique @map("product_id") @db.Uuid
  visible     Boolean  @default(false)
  description String?
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([shopId, visible])
  @@map("ecommerce_product_details")
}

model EcommerceProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  shopId    String   @map("shop_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  url       String
  source    String   @default("UPLOAD")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([shopId, productId, sortOrder])
  @@map("ecommerce_product_images")
}

model EcommerceOrder {
  id                String               @id @default(uuid()) @db.Uuid
  shopId            String               @map("shop_id") @db.Uuid
  orderNumber       String               @map("order_number")
  customerName      String               @map("customer_name")
  customerPhone     String               @map("customer_phone")
  deliveryAddress   String?              @map("delivery_address")
  fulfillmentMethod String               @map("fulfillment_method")
  status            String               @default("PENDING")
  subtotal          Decimal              @default(0) @db.Decimal(14, 2)
  deliveryFee       Decimal              @default(0) @map("delivery_fee") @db.Decimal(14, 2)
  total             Decimal              @default(0) @db.Decimal(14, 2)
  note              String?
  customerId        String?              @map("customer_id") @db.Uuid
  idempotencyKey    String?              @map("idempotency_key")
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  shop              Shop                 @relation(fields: [shopId], references: [id], onDelete: Cascade)
  items             EcommerceOrderItem[]
  customer          EcommerceCustomer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@unique([shopId, orderNumber])
  @@unique([shopId, idempotencyKey])
  @@index([shopId, status, createdAt])
  @@map("ecommerce_orders")
}

model EcommerceCustomer {
  id                  String                       @id @default(uuid()) @db.Uuid
  shopId              String                       @map("shop_id") @db.Uuid
  telegramUserId      String?                      @map("telegram_user_id")
  googleSubject       String?                      @map("google_subject")
  email               String?
  displayName         String?                      @map("display_name")
  telegramChatId      String?                      @map("telegram_chat_id")
  telegramUsername    String?                      @map("telegram_username")
  telegramFirstName   String?                      @map("telegram_first_name")
  telegramLastName    String?                      @map("telegram_last_name")
  telegramPhotoUrl    String?                      @map("telegram_photo_url")
  languageCode        String?                      @map("language_code")
  phone               String?
  notificationConsent Boolean                      @default(true) @map("notification_consent")
  telegramConnectedAt DateTime?                    @map("telegram_connected_at") @db.Timestamptz(6)
  lastLoginAt         DateTime                     @default(now()) @map("last_login_at") @db.Timestamptz(6)
  lastOrderAt         DateTime?                    @map("last_order_at") @db.Timestamptz(6)
  createdAt           DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(6)
  shop                Shop                         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  sessions            EcommerceCustomerSession[]
  addresses           EcommerceCustomerAddress[]
  favourites          EcommerceCustomerFavourite[]
  carts               EcommerceCart[]
  orders              EcommerceOrder[]

  @@unique([shopId, telegramUserId])
  @@unique([shopId, googleSubject])
  @@index([shopId, lastLoginAt])
  @@map("ecommerce_customers")
}

model EcommerceCustomerSession {
  id               String            @id @default(uuid()) @db.Uuid
  customerId       String            @map("customer_id") @db.Uuid
  sessionTokenHash String            @unique @map("session_token_hash")
  expiresAt        DateTime          @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime?         @map("revoked_at") @db.Timestamptz(6)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  customer         EcommerceCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, expiresAt])
  @@map("ecommerce_customer_sessions")
}

model EcommerceCustomerAddress {
  id            String            @id @default(uuid()) @db.Uuid
  customerId    String            @map("customer_id") @db.Uuid
  recipientName String            @map("recipient_name")
  phone         String
  addressLine   String            @map("address_line")
  township      String?
  city          String?
  note          String?
  isDefault     Boolean           @default(false) @map("is_default")
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  customer      EcommerceCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, isDefault])
  @@map("ecommerce_customer_addresses")
}

model EcommerceCustomerFavourite {
  customerId String            @map("customer_id") @db.Uuid
  productId  String            @map("product_id") @db.Uuid
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  customer   EcommerceCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@id([customerId, productId])
  @@map("ecommerce_customer_favourites")
}

model EcommerceCart {
  id             String              @id @default(uuid()) @db.Uuid
  shopId         String              @map("shop_id") @db.Uuid
  customerId     String?             @map("customer_id") @db.Uuid
  guestSessionId String?             @map("guest_session_id")
  status         String              @default("ACTIVE")
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  shop           Shop                @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customer       EcommerceCustomer?  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items          EcommerceCartItem[]

  @@index([shopId, customerId, status])
  @@index([shopId, guestSessionId, status])
  @@map("ecommerce_carts")
}

model EcommerceCartItem {
  id                String        @id @default(uuid()) @db.Uuid
  cartId            String        @map("cart_id") @db.Uuid
  productId         String        @map("product_id") @db.Uuid
  productVariantId  String?       @map("product_variant_id") @db.Uuid
  quantity          Int
  unitPriceSnapshot Decimal       @map("unit_price_snapshot") @db.Decimal(14, 2)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  cart              EcommerceCart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@unique([cartId, productVariantId])
  @@index([cartId])
  @@map("ecommerce_cart_items")
}

model EcommerceTelegramConnectionToken {
  id         String    @id @default(uuid()) @db.Uuid
  customerId String    @map("customer_id") @db.Uuid
  shopId     String    @map("shop_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt     DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([customerId, expiresAt])
  @@map("ecommerce_telegram_connection_tokens")
}

model EcommerceOrderItem {
  id                  String         @id @default(uuid()) @db.Uuid
  orderId             String         @map("order_id") @db.Uuid
  productVariantId    String         @map("product_variant_id") @db.Uuid
  productNameSnapshot String         @map("product_name_snapshot")
  variantNameSnapshot String?        @map("variant_name_snapshot")
  unitPrice           Decimal        @map("unit_price") @db.Decimal(14, 2)
  quantity            Int
  lineTotal           Decimal        @map("line_total") @db.Decimal(14, 2)
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  order               EcommerceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productVariantId])
  @@map("ecommerce_order_items")
}

model ProductVariant {
  id                   String    @id @default(uuid()) @db.Uuid
  shopId               String    @map("shop_id") @db.Uuid
  productId            String    @map("product_id") @db.Uuid
  categoryId           String?   @map("category_id") @db.Uuid
  variantName          String    @map("variant_name")
  sku                  String?
  barcode              String?
  unit                 String?
  ram                  String?
  storage              String?
  color                String?
  expiryDate           DateTime? @map("expiry_date") @db.Date
  costPrice            Decimal   @default(0) @map("cost_price") @db.Decimal(14, 2)
  standardSellingPrice Decimal   @default(0) @map("standard_selling_price") @db.Decimal(14, 2)
  wholesalePrice       Decimal   @default(0) @map("wholesale_price") @db.Decimal(14, 2)
  minimumSellingPrice  Decimal   @default(0) @map("minimum_selling_price") @db.Decimal(14, 2)
  active               Boolean   @default(true)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  category         Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  inventoryBalance InventoryBalance?
  product          Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  saleItems        SaleItem[]
  shop             Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  stockMovements   StockMovement[]

  @@unique([shopId, sku])
  @@unique([shopId, barcode])
  @@index([shopId, active])
  @@index([shopId, expiryDate])
  @@map("product_variants")
}

model InventoryBalance {
  id               String   @id @default(uuid()) @db.Uuid
  shopId           String   @map("shop_id") @db.Uuid
  productVariantId String   @unique @map("product_variant_id") @db.Uuid
  quantity         Int      @default(0)
  minAlertQuantity Int      @default(0) @map("min_alert_quantity")
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  productVariant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  shop           Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, productVariantId])
  @@index([shopId, quantity])
  @@map("inventory_balances")
}

model StockMovement {
  id               String            @id @default(uuid()) @db.Uuid
  shopId           String            @map("shop_id") @db.Uuid
  productVariantId String            @map("product_variant_id") @db.Uuid
  type             StockMovementType
  quantityChange   Int               @map("quantity_change")
  beforeQuantity   Int               @map("before_quantity")
  afterQuantity    Int               @map("after_quantity")
  referenceType    String?           @map("reference_type")
  referenceId      String?           @map("reference_id") @db.Uuid
  userId           String?           @map("user_id") @db.Uuid
  note             String?
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  productVariant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  shop           Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user           User?          @relation("StockMovementUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([shopId, productVariantId, createdAt])
  @@index([shopId, type, createdAt])
  @@map("stock_movements")
}

model Customer {
  id        String   @id @default(uuid()) @db.Uuid
  shopId    String   @map("shop_id") @db.Uuid
  name      String
  phone     String?
  address   String?
  balance   Decimal  @default(0) @db.Decimal(14, 2)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  repairs Repair[]
  sales   Sale[]
  shop    Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, phone])
  @@index([shopId, name])
  @@map("customers")
}

model Sale {
  id            String        @id @default(uuid()) @db.Uuid
  shopId        String        @map("shop_id") @db.Uuid
  invoiceNumber String        @map("invoice_number")
  customerId    String?       @map("customer_id") @db.Uuid
  userId        String        @map("user_id") @db.Uuid
  status        SaleStatus    @default(COMPLETED)
  subtotal      Decimal       @default(0) @db.Decimal(14, 2)
  discount      Decimal       @default(0) @db.Decimal(14, 2)
  total         Decimal       @default(0) @db.Decimal(14, 2)
  costTotal     Decimal       @default(0) @map("cost_total") @db.Decimal(14, 2)
  profitTotal   Decimal       @default(0) @map("profit_total") @db.Decimal(14, 2)
  paymentStatus PaymentStatus @default(PENDING) @map("payment_status")
  soldAt        DateTime      @default(now()) @map("sold_at") @db.Timestamptz(6)
  voidedAt      DateTime?     @map("voided_at") @db.Timestamptz(6)
  voidReason    String?       @map("void_reason")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items    SaleItem[]
  payments Payment[]
  shop     Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user     User       @relation("SaleStaff", fields: [userId], references: [id], onDelete: Restrict)

  @@unique([shopId, invoiceNumber])
  @@index([shopId, soldAt])
  @@index([shopId, paymentStatus])
  @@index([shopId, userId, soldAt])
  @@map("sales")
}

model SaleItem {
  id                   String   @id @default(uuid()) @db.Uuid
  shopId               String   @map("shop_id") @db.Uuid
  saleId               String   @map("sale_id") @db.Uuid
